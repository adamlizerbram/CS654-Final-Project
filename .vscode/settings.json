{
    "editor.formatOnSave": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.watcherExclude": {
        "**/.conda/**": true,
        "**/__pycache__/**": true,
        "**/models/**": true,
        "**/data/**": true,
        "**/results/**": true,
        "**/videos/**": true,
        "**/wandb/**": true,
        "**/runs/**": true
    },
    "search.exclude": {
        "**/.conda": true,
        "**/__pycache__": true,
        "**/models": true,
        "**/data": true,
        "**/results": true,
        "**/videos": true,
        "**/wandb": true,
        "**/runs": true
    },
    "workbench.iconTheme": "material-icon-theme",
    "trailing-spaces.trimOnSave": true,
}
